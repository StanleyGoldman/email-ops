{
  "permissions": {
    "ask": [
      "Bash(node act.mjs --confirm:*)",
      "Bash(node ./act.mjs --confirm:*)"
    ],
    "deny": [
      "Bash(himalaya:*)",
      "Bash(secret-tool:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
